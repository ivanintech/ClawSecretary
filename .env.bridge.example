# SecretaryOS Bridge Environment Variables
# Copy this file to .env.bridge and fill in your values

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Security (required - generate with: openssl rand -base64 32)
SESSION_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
JWT_SECRET=generate-with-openssl-rand-base64-32
